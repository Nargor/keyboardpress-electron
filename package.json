{
  "name": "keypress-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent window overlay that shows your keyboard presses — for OBS / streaming.",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build:ui && npx electron .",
    "test": "npm run build:ui && KEY_OVERLAY_TEST=1 npx electron .",
    "build:ui": "esbuild ui/main.ts --bundle --outfile=resources/js/main.js --format=iife --target=es2020 --sourcemap",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist": "npm run build:ui && electron-builder",
    "release": "npm run build:ui && electron-builder --win portable"
  },
  "dependencies": {
    "koffi": "^3.1.5"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.keypress.overlay",
    "productName": "KeyPressOverlay",
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    }
  }
}
